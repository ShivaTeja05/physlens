# Copy to backend/.env (git-ignored) and fill in what you have. Nothing here is required:
# without keys the engine runs offline (motion tracker, template explanations, no 3D from the GPU).

# Meta Model API (SAM 3.1, Muse Spark, Muse Voice): one key for all of them
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
MUSE_EFFORT=low
MUSE_ASK_EFFORT=low

# Spending cap for Meta API calls, in US dollars (calls are refused past it; log: backend/.spend.jsonl)
PHYSLENS_BUDGET_USD=50

# RunPod serverless GPU worker (MapAnything + MoGe-3), see gpu_worker/README.md
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Force the offline tracker even when a Meta key is set: motion
#PHYSLENS_TRACKER=motion
